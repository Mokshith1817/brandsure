# =========================================================================
# BrandSure Environment Variables
# Copy this file to .env.local and fill in the values
# =========================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only: NEVER expose this to the browser or git
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration
# Server-side only: NEVER expose this to the browser
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographic Session Signing Secret (HMAC-SHA256)
# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=your-32-byte-random-session-secret

# Demo Mode (ONLY for local development without Supabase)
# In production, leave unset or set to false.
DEMO_MODE=false
